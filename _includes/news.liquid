<div class="news">
  {% if site.news != blank %}
    {% assign news_size = site.news | size %}
    <div
      class="news-list"
      {% if include.limit and page.announcements.scrollable and news_size > 3 %}
        data-scrollable="true"
      {% endif %}
    >
      {% assign news = site.news | sort: 'date' | reverse %}
      {% if include.limit and page.announcements.limit %}
        {% assign news_limit = page.announcements.limit %}
      {% else %}
        {% assign news_limit = news_size %}
      {% endif %}
      {% for item in news limit: news_limit %}
        <article class="news-card{% if item.image or item.images %} has-image{% endif %}">
          <div class="news-meta">
            <time datetime="{{ item.date | date: '%Y-%m-%d' }}">{{ item.date | date: '%b %d, %Y' }}</time>
            <span>update</span>
          </div>
          <div class="news-content">
            <div class="news-body">
              {% if item.inline %}
                {{ item.content | remove: '<p>' | remove: '</p>' | emojify }}
              {% else %}
                <a class="news-title" href="{{ item.url | relative_url }}">{{ item.title }}</a>
              {% endif %}
            </div>
            {% if item.images or item.image %}
              <div class="news-media" aria-label="News photos">
                {% if item.images %}
                  {% for image in item.images %}
                    {% assign news_image_source = image.path | default: image %}
                    {% assign news_image_alt = image.alt | default: item.image_alt | default: 'News photo' %}
                    {% if news_image_source contains '://' %}
                      {% assign news_image_path = news_image_source %}
                    {% else %}
                      {% assign news_image_path = news_image_source | prepend: '/assets/img/' | relative_url %}
                    {% endif %}
                    <a class="news-image" href="{{ news_image_path }}" aria-label="Open photo for {{ item.date | date: '%b %d, %Y' }} news">
                      <img src="{{ news_image_path }}" alt="{{ news_image_alt }}">
                    </a>
                  {% endfor %}
                {% else %}
                  {% if item.image contains '://' %}
                    {% assign news_image_path = item.image %}
                  {% else %}
                    {% assign news_image_path = item.image | prepend: '/assets/img/' | relative_url %}
                  {% endif %}
                  <a class="news-image" href="{{ news_image_path }}" aria-label="Open photo for {{ item.date | date: '%b %d, %Y' }} news">
                    <img src="{{ news_image_path }}" alt="{{ item.image_alt | default: 'News photo' }}">
                  </a>
                {% endif %}
              </div>
            {% endif %}
          </div>
        </article>
      {% endfor %}
    </div>
  {% else %}
    <p>No news so far...</p>
  {% endif %}
</div>
